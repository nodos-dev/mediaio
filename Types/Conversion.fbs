namespace nos.mediaio;

// TODO: Move to nos.sys.mediaio

enum ColorSpace : uint {
    REC709  = 0,
    REC601  = 1,
    REC2020 = 2,
    SGAMUT3 = 3,
    SGAMUT3CINE = 4,
}

// must match GammaFunctions.glsl
enum GammaCurve : uint {
    REC709  = 0,
    HLG  = 1,
    ST2084 = 2,
    SRGB = 3,
    IDENTITY = 4,
    SLOG3 = 5,
}

enum GammaConversionType : uint {
    ENCODE, // From linear to non-linear
    DECODE, // From non-linear to linear
}

// SMPTE 352 (VPID) luminance signalling for HDR output.
enum VPIDLuminance : uint {
    YCbCr = 0,
    ICtCp = 1,
}

// Quantization range signalling (VPID / SMPTE narrow vs full).
enum SignalRange : uint {
    Narrow = 0,
    Full = 1,
}

// How EncodeHDRMetadata fills the luminance / content-light-level fields.
enum HDRMetadataMode : uint {
    Auto = 0,   // Derive from the gamma curve; the value pins are read-only.
    Custom = 1, // Enter the values manually.
}

// HDR10 static metadata: SMPTE ST 2086 mastering-display colour volume plus
// CTA-861.3 content light levels. Consumed by InjectHDRMetadata to build a
// SMPTE ST 2108-1 ANC packet. Values are in physical units (CIE xy, nits);
// the node applies the ST 2086 scaling. Struct fields can't carry defaults —
// the InjectHDRMetadata nosnode seeds Rec2020 / D65 / 1000-nit defaults.
struct HDRMetadata {
    // CIE 1931 xy chromaticity of the mastering-display primaries.
    red_x: float;   red_y: float;
    green_x: float; green_y: float;
    blue_x: float;  blue_y: float;
    // CIE 1931 xy chromaticity of the mastering-display white point.
    white_x: float; white_y: float;
    // Mastering-display luminance, cd/m^2 (nits).
    max_luminance: float;
    min_luminance: float;
    // Content light level, cd/m^2 (nits): brightest pixel (MaxCLL) and
    // brightest frame-average (MaxFALL). 0 signals "unknown" per CTA-861.3.
    max_cll: uint;
    max_fall: uint;
}

enum InterlacedFlags : uint(bit_flags) {
    // Interlaced
    OUTPUT_EVEN = 0,
    OUTPUT_ODD = 1,
    INPUT_EVEN = 2,
    INPUT_ODD = 3,
}

// TODO: Merge YCbCrPixelFormat and RGBPixelFormat into a single PixelFormat enum covering
// both the YCbCr and RGB packed layouts, and migrate the conversion nodes to it.
enum YCbCrPixelFormat: uint {
    YUV8,
    V210
}

// Packed pixel layout TextureToBuffer writes into its output buffer (and RecordClip
// writes to disk). Must match the PIXEL_FORMAT_* defines in TextureToBuffer.comp.
//   RGBA8  - 4 channels,  8-bit, one 32-bit word per pixel
//   RGBA16 - 4 channels, 16-bit, two 32-bit words per pixel
//   RGB10  - 3 channels, 10-bit, DPX Method A (R[31:22] G[21:12] B[11:2], 2 pad bits)
//   RGB8   - 3 channels,  8-bit, tightly packed (3 bytes per pixel)
enum RGBPixelFormat : uint {
    RGBA8,
    RGBA16,
    RGB10,
    RGB8
}