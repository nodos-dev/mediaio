            {
              "id": "ef514a29-e2e4-46dd-84e3-af68ab7b5b6f",
              "name": "ListDirectory",
              "class_name": "nos.utilities.ListDirectory",
              "pins": [
                {
                  "id": "c6f33bcc-2da4-432b-a856-729141992904",
