                  },
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Header of the current frame: resolution, windows, pixel type, compression, channels\nand layers.",
                  "display_name": "Metadata"
                },
                {
                  "id": "20232bf0-3bb1-4cbf-8f2f-13d595676dff",
                  "name": "Files",
                  "type_name": "[string]",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_ONLY",
                  "visualizer": {
                  },
                  "data": [],
                  "def": [],
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Ordered list of .exr file paths, one per frame. Frame Index plays Files[Index].\nUsually driven by a node that lists a directory.",
                  "display_name": "Files"
                },
                {
                  "id": "14feb409-14a3-4e34-a555-c9e9fc25f74a",
                  "name": "UploadAhead",
                  "type_name": "ulong",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 4,
                  "min": 1,
                  "max": 128,
                  "def": 8,
                  "step": 1.27,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "How many decoded frames ahead of Index the uploader threads copy to the GPU early, so\nshowing a frame never waits on its transfer. A larger runway banks uploads during easy\nstretches and rides out single uploads running longer than a frame interval, at the cost\nof that many frames of extra VRAM and CPU memory held in flight.",
                  "display_name": "Upload Ahead"
                }
              ],
              "pos": { "x": -70.0, "y": -99.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "status_messages": [
                { "text": "Set Files list", "type": "WARNING" }
              ],
              "description": "Plays an OpenEXR image sequence from a list of files in real time. A pool of worker\nthreads reads and decodes frames ahead of the current Index - in parallel across frames -\ninto a bounded GPU cache; each execution just hands out the already-decoded frame for\nIndex. Because the slow per-frame read+decode happens ahead of the playhead, playback\ndoes not stall on it as long as the workers stay ahead. Index wraps modulo the file count\nand the prefetch window wraps with it, so a free-running counter loops the clip without a\nstutter at the seam. Drive Index from a frame counter to play, or set it directly to\nscrub. Outputs the frame's Texture, its Z as Depth, and its header on Metadata; holds the\nlast frame while the current one is still buffering.",
              "display_name": "Read EXR Sequence",
              "plugin_version": { "major": 2, "minor": 11, "patch": 0 }
            },
