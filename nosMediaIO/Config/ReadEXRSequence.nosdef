{
    "nodes": [
        {
            "class_name": "ReadEXRSequence",
            "menu_info": {
                "category": "Media IO|File",
                "display_name": "Read EXR Sequence",
                "name_aliases": [ "exr sequence reader", "prefetching read exr", "read exr sequence", "exr frame cache" ]
            },
            "node": {
                "class_name": "ReadEXRSequence",
                "display_name": "Read EXR Sequence",
                "contents_type": "Job",
                "description": "Reads frame Index of an OpenEXR image sequence in real time. A pool of worker threads\nreads and decodes frames ahead of the current Index - in parallel across frames - into a\nbounded GPU cache; each execution hands out the frame for Index, blocking until it is\ndecoded and uploaded, so the path paces on real throughput and never repeats a stale\nframe. Because the slow per-frame read+decode happens ahead of the playhead, that wait is\nnormally zero. Index wraps modulo the file count and the prefetch window wraps with it,\nso a free-running counter loops the clip without a stutter at the seam. Drive Index from\na frame counter to play (see the Play EXR graph node), or set it directly to scrub.\nOutputs the frame's Texture, its Z as Depth, and its header on Metadata; only a failed\nframe holds the last good one while it retries.",
                "pins": [
                    {
                        "name": "Index",
                        "display_name": "Index",
                        "description": "Index of the file in Files to display, typically incremented by 1 each frame. Wrapped\nmodulo the list length, so a free-running counter loops the sequence seamlessly - the\nprefetch window wraps with it, decoding the first frames again while the last ones play.\nA frame is decoded once, so repeating or holding an index costs nothing.",
                        "type_name": "ulong",
                        "show_as": "INPUT_PIN",
                        "can_show_as": "INPUT_PIN_OR_PROPERTY",
                        "data": 0
                    },
                    {
                        "name": "PrefetchAhead",
                        "display_name": "Prefetch Ahead",
                        "description": "How many frames the workers read and decode ahead of Index. Must exceed the worker\ncount (up to 16) for all of them to stay busy; higher also buffers against decode\njitter but holds more CPU + GPU memory (a 4K RGBA16F frame is ~66 MB, plus depth).",
                        "type_name": "ulong",
                        "show_as": "PROPERTY",
                        "can_show_as": "INPUT_PIN_OR_PROPERTY",
                        "data": 32,
                        "min": 1,
                        "max": 128
                    },
                    {
                        "name": "UploadAhead",
                        "display_name": "Upload Ahead",
                        "description": "How many decoded frames ahead of Index the uploader threads copy to the GPU early, so\nshowing a frame never waits on its transfer. A larger runway banks uploads and rides out\nsingle uploads running longer than a frame interval, at the cost of that many frames of\nextra VRAM and CPU memory held in flight. The default covers ordinary jitter; raise it\nfor graphs with longer transfer stalls.",
                        "type_name": "ulong",
                        "show_as": "PROPERTY",
                        "can_show_as": "INPUT_PIN_OR_PROPERTY",
                        "data": 4,
                        "min": 1,
                        "max": 128
                    },
                    {
                        "name": "Texture",
                        "display_name": "Texture",
                        "description": "Current frame. RGBA16F for HALF files, RGBA32F for FLOAT / UINT files. Execution waits\nfor the frame, so this always carries Files[Index]; only a failed frame holds the\nprevious texture while it retries.",
                        "type_name": "nos.sys.vulkan.Texture",
                        "show_as": "OUTPUT_PIN",
                        "can_show_as": "OUTPUT_PIN_ONLY"
                    },
                    {
                        "name": "Depth",
                        "display_name": "Depth",
                        "description": "Single-channel R32F depth from the frame's 'Z' channel, when present.",
                        "type_name": "nos.sys.vulkan.Texture",
                        "show_as": "OUTPUT_PIN",
                        "can_show_as": "OUTPUT_PIN_ONLY"
                    },
                    {
                        "name": "Metadata",
                        "display_name": "Metadata",
                        "description": "Header of the current frame: resolution, windows, pixel type, compression, channels\nand layers.",
                        "type_name": "nos.mediaio.EXRMetadata",
                        "show_as": "OUTPUT_PIN",
                        "can_show_as": "OUTPUT_PIN_ONLY"
                    },
                    {
                        "name": "Files",
                        "display_name": "Files",
                        "description": "Ordered list of .exr file paths, one per frame. Frame Index plays Files[Index].\nUsually driven by a node that lists a directory.",
                        "type_name": "[string]",
                        "show_as": "INPUT_PIN",
                        "can_show_as": "INPUT_PIN_ONLY"
                    }
                ]
            }
        }
    ]
}
