            },
            {
              "id": "1ffee3ba-57b4-482c-9a28-5bd1cb6086af",
              "name": "ReadEXRSequence",
              "class_name": "nos.mediaio.ReadEXRSequence",
              "pins": [
                {
                  "id": "bb076f45-2752-4106-a14c-d1b5b478bf2f",
                  "name": "Index",
                  "type_name": "ulong",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 9223372036854775808,
                  "def": 0,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Index of the file in Files to display, typically incremented by 1 each frame. Wrapped\nmodulo the list length, so a free-running counter loops the sequence seamlessly - the\nprefetch window wraps with it, decoding the first frames again while the last ones play.\nA frame is decoded once, so repeating or holding an index costs nothing.",
                  "display_name": "Index"
                },
                {
                  "id": "f8bde041-b031-4369-a5de-69c1f98eba7b",
                  "name": "PrefetchAhead",
                  "type_name": "ulong",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 32,
                  "min": 1,
                  "max": 128,
                  "def": 32,
                  "step": 1.27,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "How many frames the workers read and decode ahead of Index. Must exceed the worker\ncount (up to 16) for all of them to stay busy; higher also buffers against decode\njitter but holds more CPU + GPU memory (a 4K RGBA16F frame is ~66 MB, plus depth).",
                  "display_name": "Prefetch Ahead"
                },
                {
                  "id": "02f87fb0-ef47-4705-adb1-ebcf12f930d4",
                  "name": "Texture",
                  "type_name": "nos.sys.vulkan.Texture",
